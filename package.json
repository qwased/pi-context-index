{
  "name": "pi-context-index",
  "version": "0.1.0",
  "description": "LLM-free conversation compaction and history retrieval for Pi - a continuation capsule plus an addressable session archive",
  "license": "MIT",
  "main": "index.ts",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "!src/**/*.bak",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "compaction",
    "context",
    "index",
    "recall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwased/pi-context-index.git"
  },
  "homepage": "https://github.com/qwased/pi-context-index#readme",
  "bugs": {
    "url": "https://github.com/qwased/pi-context-index/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "bun test",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "typebox": "1.3.32",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <2.0.0",
    "typebox": ">=1.1.24 <2.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
